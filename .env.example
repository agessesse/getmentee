# ─── Supabase ─────────────────────────────────────────────────────────────────
# Required. Get these from your Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. Required for the /admin dashboard and for account deletion
# (/api/account/delete), both of which need to read or write across users.
# NEVER prefix with NEXT_PUBLIC_ and never commit a real value.
# Supabase project -> Settings -> API -> service_role secret.
# SUPABASE_SERVICE_KEY is accepted as a legacy alias (used by scripts/seed-demo.ts).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Voice / Session Intelligence ─────────────────────────────────────────────
# Required for: voice cleanup (filler-word removal, punctuation), post-session
# summaries, and action-item generation. Server-side only — NEVER prefix with
# NEXT_PUBLIC_. The application degrades gracefully when this key is absent:
# dictation still works via the browser's Web Speech API, but cleanup and
# AI summaries will be unavailable.
#
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Set to 'false' to hide all voice UI without removing the implementation.
# Useful for rolling back voice features without a code deploy.
# Omit or set to 'true' to enable voice features (default: enabled).
NEXT_PUBLIC_VOICE_ENABLED=true

# Renders the demo account block on the public /login page, credentials and all.
# Leave unset in production — it is a public URL.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
